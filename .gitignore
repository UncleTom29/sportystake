# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies — unanchored so it also matches packages/*/node_modules in
# this pnpm monorepo, not just the root.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# npm lockfiles anywhere in the monorepo — pnpm-lock.yaml at the root is the
# single source of truth; a stray package-lock.json means npm ran somewhere
# it shouldn't have.
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# hardhat (packages/contracts)
artifacts/
cache/
typechain-types/

# package build output
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# stray debug output
*.stderr

# python bytecode cache (oracle scraper scripts)
__pycache__/
*.pyc
