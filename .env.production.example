# SportyStake — production env template for the EC2 host.
# Copy to /etc/sportystake/.env on the box (chmod 600, owned by the
# `sportystake` user) and fill in every placeholder below. Every var here
# is validated by src/lib/env.ts at process boot — the app refuses to start
# if a required one is missing or malformed.

# -- App ---------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sportystake.com
LOG_LEVEL=info

# -- Auth (JWT & Privy) -------------------------------------------------------
JWT_SECRET=                      # openssl rand -hex 32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# -- Privy Authentication (Email & Social Login) ----------------------------
NEXT_PUBLIC_PRIVY_APP_ID=        # dashboard.privy.io
PRIVY_APP_SECRET=                # dashboard.privy.io

# -- Database / Redis (run natively on this box, or point at RDS/ElastiCache)
DATABASE_URL=postgresql://sportystake:CHANGE_ME@localhost:5432/sportystake
REDIS_URL=redis://localhost:6379

# -- Oracle service (internal-only, never exposed to nginx/Cloudflare) ------
ORACLE_INTERNAL_API_URL=http://localhost:3002
ORACLE_INTERNAL_API_KEY=         # openssl rand -hex 32 — MUST override the "change-me" default

# -- Smart contracts (Arc Testnet — no mainnet deployment yet) --------------
NEXT_PUBLIC_CHAIN_ID=5042002
NEXT_PUBLIC_RPC_URL=https://arc-testnet.drpc.org
NEXT_PUBLIC_BETTING_CORE_ADDRESS=0x091E1Fe9576E4E090FE95eD8bB25a19B01FAbcf0
NEXT_PUBLIC_LIQUIDITY_POOL_ADDRESS=0x574DF566b98E6f3Cb7459b39BFD9afeD8694A154
NEXT_PUBLIC_CASINO_HOUSE_ADDRESS=0x615f95fa5ccCe9Cd79d7aBc0e37983aaDD9f9b9d
NEXT_PUBLIC_CRASH_GAME_ADDRESS=0xa7FF5FB348FeEfEf4C092CD67AE62344A33Be8A0
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# -- Operator keys (see PRODUCTION_TODO.md — flat env var here is a known,
# accepted gap; move to KMS/HSM before this custodies real funds) ----------
OPERATOR_PRIVATE_KEY_CASINO=
OPERATOR_PRIVATE_KEY_CRASH=
OPERATOR_PRIVATE_KEY_BETTING=
ORACLE_ATTESTATION_PRIVATE_KEY=

# -- Analytics / AI (optional) -----------------------------------------------
ANTHROPIC_API_KEY=
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# -- Security ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://sportystake.com
RATE_LIMIT_RPM=120
RATE_LIMIT_BURST=20
