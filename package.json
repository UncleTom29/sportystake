{
  "name": "sportystake-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run stop && npm run infra:up && node scripts/init.mjs",
    "init": "node scripts/init.mjs",
    "dev": "concurrently -k -n web,oracle,sync,settle,crash -c blue,magenta,cyan,yellow,green \"npm:dev:web\" \"npm:dev:oracle\" \"npm:dev:sync-worker\" \"npm:dev:settlement-worker\" \"npm:dev:crash-worker\"",
    "dev:web": "next dev",
    "dev:oracle": "npm --prefix packages/oracle run dev",
    "dev:sync-worker": "tsx watch --env-file=.env src/workers/oracle-sync.worker.ts",
    "dev:settlement-worker": "tsx watch --env-file=.env src/workers/settlement.worker.ts",
    "dev:crash-worker": "tsx watch --env-file=.env src/workers/crash-scheduler.worker.ts",
    "worker:crash": "tsx --env-file=.env src/workers/crash-scheduler.worker.ts",
    "dev:contracts": "npm --prefix packages/contracts run node",
    "dev:sdk": "npm --prefix packages/sdk run dev",
    "naijabet:ping": "npm --prefix packages/oracle run ping:naijabet",
    "naijabet:ping:extended": "npm --prefix packages/oracle run ping:naijabet:extended",
    "naijabet:ping:sports": "npm --prefix packages/oracle run ping:naijabet:sports",
    "naijabet:ping:compare:bet9ja": "npm --prefix packages/oracle run ping:naijabet:compare:bet9ja",
    "naijabet:ping:allbooks": "npm --prefix packages/oracle run ping:naijabet:allbooks",
    "naijabet:ping:sportybet:playwright": "npm --prefix packages/oracle run ping:naijabet:sportybet:playwright",
    "naijabet:ping:allbooks:playwright": "npm --prefix packages/oracle run ping:naijabet:allbooks:playwright",
    "naijabet:ping:multi-providers:all": "npm --prefix packages/oracle run ping:multi-providers:all",
    "naijabet:ping:multi-providers:subset": "npm --prefix packages/oracle run ping:multi-providers:subset",
    "scrape:multi-providers:raw": "npm --prefix packages/oracle run scrape:multi-providers:raw",
    "stop": "node scripts/stop.mjs",
    "stop:all": "node scripts/stop.mjs && docker compose down",
    "infra:up": "node scripts/wait-for-infra.mjs",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v && npm run infra:up && npm run db:migrate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test:stress": "tsx scripts/stress-test.ts",
    "db:reset": "prisma migrate reset --force",
    "contracts:compile": "npm --prefix packages/contracts run compile",
    "contracts:test": "npm --prefix packages/contracts run test",
    "contracts:deploy:local": "npm --prefix packages/contracts run deploy:local",
    "contracts:deploy:arc": "npm --prefix packages/contracts run deploy:arc",
    "liquidity": "tsx --env-file=.env scripts/manage-liquidity.ts",
    "liquidity:check": "tsx --env-file=.env scripts/manage-liquidity.ts check",
    "rollover-bot": "tsx --env-file=.env scripts/rollover-bot/run.ts pick",
    "rollover-bot:resolve": "tsx --env-file=.env scripts/rollover-bot/run.ts resolve",
    "rollover-bot:status": "tsx --env-file=.env scripts/rollover-bot/run.ts status",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "setup": "npm install && npm --prefix packages/oracle install && npm --prefix packages/sdk install && npm --prefix packages/contracts install && npm run db:generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@prisma/client": "^5.20.0",
    "@privy-io/node": "^0.28.0",
    "@privy-io/react-auth": "^3.36.0",
    "@tanstack/react-query": "^5.20.0",
    "ioredis": "^5.4.1",
    "jose": "^5.2.0",
    "lucide-react": "^1.33.0",
    "nanoid": "^5.0.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.7.0",
    "wagmi": "^2.5.0",
    "zod": "^3.22.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prettier": "^3.3.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
